# NavNiti Environment Variables

# Port for FastAPI server (Default: 8000)
PORT=8000

# Database URL for Supabase/PostgreSQL Connection String
# To connect to Supabase, paste your connection string here.
# e.g., postgresql://postgres.YOUR-REF-ID:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
SUPABASE_DB_URL=

# Google Gemini API key for advanced NLP complaint classification & summarization (Optional)
# If left blank, the backend falls back to local keyword heuristics
GEMINI_API_KEY=
